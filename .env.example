# =============================================================================
# Faculty Publication Intelligence Agent - Environment Configuration
# =============================================================================

# ---- Database ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/faculty_pub_agent?schema=public"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# ---- Gemini AI ----
GEMINI_API_KEY="your-gemini-api-key"

# ---- Redis (BullMQ) ----
REDIS_URL="redis://localhost:6379"

# ---- SMTP Email ----
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@youruniversity.edu"

# ---- Storage ----
# Options: local, s3
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./uploads"
# S3 (optional, for future use)
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION=""
STORAGE_S3_ACCESS_KEY=""
STORAGE_S3_SECRET_KEY=""
STORAGE_S3_ENDPOINT=""

# ---- External APIs ----
# Scopus (optional - uses mock if empty)
SCOPUS_API_KEY=""
# Google Scholar proxy (optional)
SCHOLAR_PROXY_URL=""
# Serper API for Google Scholar (optional)
SERPER_API_KEY=""
# Crossref polite pool email
CROSSREF_EMAIL="admin@youruniversity.edu"
# CORE portal API key (optional)
CORE_API_KEY=""

# ---- Application ----
APP_URL="http://localhost:3000"
APP_NAME="Faculty Publication Intelligence Agent"
MAX_BATCH_SIZE="1000"
MAX_FILE_SIZE_MB="10"

# ---- Public (accessible in browser) ----
NEXT_PUBLIC_APP_NAME="Faculty Publication Intelligence Agent"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
